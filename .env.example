# Public site URL with protocol. Example: https://roguerp.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Discord invite URL for the Rogue RP community.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/roguerp

# Optional analytics provider: none | console | custom
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# Discord OAuth2 application credentials. Never expose these to the client.
# In the Discord Developer Portal, add this exact redirect:
# {NEXT_PUBLIC_SITE_URL}/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token used only on the server for guild/role checks.
DISCORD_BOT_TOKEN=

# Rogue RP Discord server (guild) ID.
DISCORD_GUILD_ID=

# Staff Discord role IDs used for server-side authorisation.
DISCORD_ROLE_OWNER=
DISCORD_ROLE_DIRECTOR=
DISCORD_ROLE_MANAGEMENT=
DISCORD_ROLE_ADMINISTRATOR=
DISCORD_ROLE_MODERATOR=
DISCORD_ROLE_DEVELOPMENT=

# Existing Rogue RP Discord Applications Bot / backend.
APPLICATION_API_URL=
APPLICATION_API_KEY=
APPLICATION_START_URL=

# FiveM server status (queried server-side only).
FIVEM_SERVER_IP=play.rogueroleplay.co.uk
FIVEM_SERVER_PORT=30120
FIVEM_CONNECT_CODE=vqqd59q
FIVEM_CONNECT_URL=https://cfx.re/join/vqqd59q
FIVEM_MAX_PLAYERS=64

# Encrypted session cookie secret. Use at least 32 random characters in production.
SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars

# Local staff login. Leave password empty to disable. Use 8+ characters.
# This grants owner-level CMS access. Do not reuse a Discord password.
STAFF_USERNAME=admin
STAFF_ACCESS_CODE=
